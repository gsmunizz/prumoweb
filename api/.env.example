# Copie para .env e carregue antes do go run (ex.: set -a; . ./.env; set +a).
PRUMO_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
# Papel prumo_app: rotas de dados, sujeito ao RLS.
DATABASE_URL=postgres://prumo_app@localhost:5432/prumo?sslmode=disable
# Papel prumo_auth: módulo de autenticação.
AUTH_DATABASE_URL=postgres://prumo_auth@localhost:5432/prumo?sslmode=disable
# Usado só pelas migrações (make migrate-up).
MIGRATE_DATABASE_URL=postgres://prumo_owner@localhost:5432/prumo?sslmode=disable
# invite (padrão até a fase 3), open ou closed.
REGISTRATION_MODE=invite
ALLOWED_EMAILS=

# Chave que assina os tokens de acesso (Ed25519, 32 bytes em base64). Gere com
# `go run ./cmd/keygen`. Obrigatória em produção; em desenvolvimento, sem ela a API
# usa uma chave temporária e os tokens morrem a cada reinício.
AUTH_SIGNING_KEY=
AUTH_SIGNING_KEY_ID=k1
# Para girar a chave: gere outra com um kid novo e deixe a pública da antiga aqui
# ("kid:base64", separadas por vírgula) até os tokens dela expirarem (15 minutos).
AUTH_PREVIOUS_PUBLIC_KEYS=
# CIDRs dos proxies à frente da API, cujo X-Forwarded-For vale. Sem isso o IP visto é o
# da conexão, e o limite de tentativas de login conta o proxy em vez do cliente.
TRUSTED_PROXIES=

# E-mails (verificação, redefinição de senha) pelo Resend. Sem a chave, em desenvolvimento,
# as mensagens (com os links) saem no log. Obrigatória em produção. O remetente de teste
# onboarding@resend.dev só entrega ao e-mail do dono da conta Resend; para outros
# destinatários é preciso verificar um domínio no Resend e trocar MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=Prumo <onboarding@resend.dev>

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo aplicativo da Web no Google
# Cloud Console e cadastre como URI de redirecionamento autorizado:
#   <APP_ORIGIN>/api/v1/auth/google/callback
# Sem as duas variáveis, as rotas /auth/google/* respondem 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Só se o callback cadastrado no Google for outro (padrão: o caminho acima).
GOOGLE_REDIRECT_URL=

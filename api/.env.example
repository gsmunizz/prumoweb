# Copie para .env e carregue antes do go run (ex.: set -a; . ./.env; set +a).
PRUMO_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
# Papel prumo_app: rotas de dados, sujeito ao RLS.
DATABASE_URL=postgres://prumo_app@localhost:5432/prumo?sslmode=disable
# Papel prumo_auth: módulo de autenticação.
AUTH_DATABASE_URL=postgres://prumo_auth@localhost:5432/prumo?sslmode=disable
# Usado só pelas migrações (make migrate-up).
MIGRATE_DATABASE_URL=postgres://prumo_owner@localhost:5432/prumo?sslmode=disable
# invite (padrão até a fase 3), open ou closed.
REGISTRATION_MODE=invite
ALLOWED_EMAILS=
